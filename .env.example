# =============================================================================
# MiniMax (LLM) — Anthropic-compatible endpoint
# =============================================================================
# Path to set: D:\Project\infer_task\pipecat_voice\.env (this file) OR
# D:\Project\infer_task\tau2-bench\.env (the file you already use for tau2).
# The harness reads both; whichever has the key wins.
#
# Copy this file to .env and fill in, OR add the same key to tau2-bench/.env.

# MiniMax-compatible key (Anthropic-style). Either name works.
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=

# Base URL. MiniMax's Anthropic-compatible endpoint:
ANTHROPIC_API_BASE=https://api.minimax.io/anthropic
MINIMAX_API_BASE=https://api.minimax.io/anthropic

# Model names. MiniMax M2.7 High-Speed is the default.
MINIMAX_AGENT_MODEL=MiniMax-M2.7
MINIMAX_USER_MODEL=MiniMax-M2.7

# =============================================================================
# tau2-bench (eval side)
# =============================================================================
TAU2_DOMAIN=retail
TAU2_TASK_SPLIT=base

# =============================================================================
# Voice pipeline defaults
# =============================================================================
PIPECAT_VOICE_STT=parakeet        # parakeet | whisper | dummy
PIPECAT_VOICE_TTS=chatterbox      # chatterbox | elevenlabs | dummy
PIPECAT_VOICE_SAMPLE_RATE=16000
PIPECAT_VOICE_MAX_SECONDS=240
PIPECAT_VOICE_SEED=42

# Parakeet
PIPECAT_PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3

# Chatterbox (optional)
PIPECAT_CHATTERBOX_VOICE=default

# ElevenLabs (only if --tts elevenlabs)
ELEVENLABS_API_KEY=
